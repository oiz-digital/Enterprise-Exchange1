    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.0",
    "@node-rs/argon2": "^2.0.2",
    "@workspace/db": "workspace:*",
    "@workspace/api-zod": "workspace:*",
    "bullmq": "^6.0.7",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "catalog:",
    "fastify": "^5.11.2",
    "fastify-plugin": "^6.0.0",
    "jose": "^6.2.8",
