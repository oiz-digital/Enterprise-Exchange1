NODE_ENV=development
PORT=8080

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zebvix

# Redis
REDIS_URL=redis://localhost:6379

# JWT — use strong random secrets in production (min 32 chars)
JWT_ACCESS_SECRET=change-me-to-a-strong-secret-min-32-chars!
JWT_REFRESH_SECRET=change-me-to-another-strong-secret-32chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# URLs
ADMIN_APP_URL=http://localhost:3001
API_BASE_URL=http://localhost:8080

# CORS — comma-separated list of allowed origins (empty = disabled)
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Logging
LOG_LEVEL=info

# BullMQ
BULLMQ_PREFIX=zebvix
